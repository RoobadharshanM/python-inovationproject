# Copy to `.env` before running:  cp .env.docker.example .env
# Compose reads this file automatically. Never commit the real `.env`.

# --- Django ---------------------------------------------------------------
# 0 in containers (gunicorn + whitenoise), 1 for a live dev server.
DJANGO_DEBUG=0
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
# Containers have dynamic hostnames. Set an explicit list in production, e.g.
#   DJANGO_ALLOWED_HOSTS=ipl.example.com,10.0.0.5
# Leave empty to fall back to localhost defaults.
DJANGO_ALLOWED_HOSTS=
# Convenience for a throwaway private-network deployment. Leave 0 in public use.
DJANGO_ALLOW_ALL_HOSTS=1
TIME_ZONE=Asia/Kolkata
ANALYTICS_CACHE_SECONDS=300

# --- Database -------------------------------------------------------------
DB_ENGINE=postgresql
DB_NAME=ipl
DB_USER=ipl
# Change this. Jenkins/CI should inject it as a secret, never a literal.
DB_PASSWORD=change-me-in-production
DB_HOST=db
DB_PORT=5432
# How long entrypoint.sh waits for postgres before giving up.
DB_WAIT_ATTEMPTS=60

# --- Web server -----------------------------------------------------------
# Host port mapped to the container's 8000.
WEB_PORT=8000
WEB_CONCURRENCY=3
WEB_TIMEOUT=120
WEB_LOG_LEVEL=info

# --- First-boot data + models ---------------------------------------------
# The entrypoint imports the CSV once and then skips it via the manifest.
IMPORT_SKIP_DATA=0
TRAIN_SKIP_MODELS=0

# --- Optional superuser ---------------------------------------------------
# CREATE_SUPERUSER=1 runs on every start and resets the password to the value
# below, so leave it at 0 unless you are seeding a fresh environment.
CREATE_SUPERUSER=0
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Jenkins (pipeline parameters) ----------------------------------------
# Set as Jenkins global environment variables, or pipeline parameters.
# REGISTRY=registry.example.com/yourorg
# DEPLOY_HOST=deploy@your-server